# ── Local environment template ──────────────────────────────
# Copy to .env.local and fill in real values:  cp .env.local.example .env.local
# .env.local is gitignored.

# Data is stored locally in SQLite (no cloud DB). Optional: override the path.
# Default: ./data/local.db
# SQLITE_PATH=./data/local.db

# AI content pipeline + chat (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key

# Optional: NotebookLM MCP (pipeline alternate)
NOTEBOOKLM_MCP_URL=

# Facebook auto-posting (optional unless using FB features)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# App URL (used in OAuth callbacks / cron)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron protection (optional locally)
CRON_SECRET=

# ── Studio (app/studio) ─────────────────────────────────────
# Studio 404s unless this is set, so a production build never serves a half-built
# route tree. `npm run dev:studio` sets it for :3001.
STUDIO_ENABLED=

# HMAC secret for the signed `desoul_tier` cookie. Unset -> the cookie is ignored
# rather than trusted, and the tier falls through to Cloudflare Access / DESOUL_TIER.
STUDIO_COOKIE_SECRET=

# owner | member | demo. Last resort, after the cookie and the Access header.
DESOUL_TIER=

# Studio's own SQLite file. Defaults to SQLITE_PATH, i.e. the same data/local.db.
# The test suite points this at data/studio-test.db.
# STUDIO_SQLITE_PATH=

# The lake. :3000 holds a write lock on data/lake.duckdb and DuckDB is single-writer
# across processes, so a second server needs its own copy: `npm run dev:lake`.
# DUCKDB_PATH=data/lake-dev.duckdb

# Own-account Threads source. Absent -> the source is listed as "needs a token",
# not hidden.
THREADS_ACCESS_TOKEN=

# Telegram delivery (slice 5b). From @BotFather. Absent -> Settings says so.
# Delivery is off until switched on in Settings, even with a token present.
TELEGRAM_BOT_TOKEN=
# Override only for tests, which point it at a local stub server.
# TELEGRAM_API_BASE=https://api.telegram.org
