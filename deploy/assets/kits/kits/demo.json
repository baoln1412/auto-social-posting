{
  "id": "demo",
  "name": "Demo",
  "schemaVersion": 1,
  "identity": {
    "channelName": "Kênh thử",
    "handle": "@demo"
  },
  "post": {
    "preset": "listicle",
    "format": "listicle",
    "length": "short",
    "emoji": "heavy",
    "hashtags": 3
  },
  "card": {
    "preset": "toi",
    "engine": "studio",
    "theme": "toi",
    "ratio": "9:16",
    "highlight": "after-colon",
    "background": "none",
    "font": "BeVietnamPro-Black",
    "radius": 28,
    "highlightColor": "#F8EF63"
  },
  "voice": {
    "preset": "namminh",
    "provider": "edge-tts",
    "voiceId": "vi-VN-NamMinhNeural"
  },
  "captions": {
    "preset": "dam",
    "size": 104,
    "pos": 0.5,
    "wordsPerCue": 2,
    "maxLines": 1,
    "case": "upper"
  },
  "frame": {
    "preset": "multi",
    "layout": "multi",
    "intro": false,
    "durationBand": "short"
  },
  "stickers": {
    "preset": "mascot",
    "set": "desoul-mascot",
    "where": [
      "cover"
    ]
  },
  "signature": {
    "handle": true,
    "watermark": true
  },
  "music": {
    "tier": "soft"
  },
  "revision": 3
}
