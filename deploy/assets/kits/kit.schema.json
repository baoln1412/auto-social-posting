{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://desoul.dev/schemas/kit.schema.json",
  "title": "Desoul Brand Kit",
  "description": "Portable by DATA, not by React. Every field here maps to something an engine already accepts — no field exists that nothing can honour.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schemaVersion",
    "identity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "$ref": "#/definitions/identity"
    },
    "post": {
      "$ref": "#/definitions/post"
    },
    "card": {
      "$ref": "#/definitions/card"
    },
    "voice": {
      "$ref": "#/definitions/voice"
    },
    "captions": {
      "$ref": "#/definitions/captions"
    },
    "frame": {
      "$ref": "#/definitions/frame"
    },
    "stickers": {
      "$ref": "#/definitions/stickers"
    },
    "signature": {
      "$ref": "#/definitions/signature"
    },
    "music": {
      "$ref": "#/definitions/music"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped when a SHIPPED kit changes. Seeding replaces a stored kit whose revision is lower, so a change to the pack actually reaches an install. An owner who has customised a shipped kit should duplicate it first: a bump replaces their copy."
    },
    "layers": {
      "$ref": "#/definitions/layers"
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelName"
      ],
      "properties": {
        "preset": {
          "type": "string"
        },
        "channelName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "format": {
          "enum": [
            "hook-first",
            "listicle",
            "qa",
            "quote-card",
            "thread"
          ]
        },
        "length": {
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "emoji": {
          "enum": [
            "none",
            "light",
            "heavy"
          ]
        },
        "hashtags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3,
          "description": "The channel's standing subjects, added to the draft prompt."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#?[^\\s#]+$"
          },
          "maxItems": 6,
          "description": "Standing hashtags. `hashtags` is how MANY to write; this is WHICH ones."
        },
        "language": {
          "enum": [
            "vi",
            "en"
          ],
          "description": "The language the post is written in. A source in another language is translated first."
        },
        "narration": {
          "enum": [
            "verbatim",
            "ai"
          ],
          "description": "verbatim: a gold row is already a finished post and passes through unchanged. ai: rewrite it even so."
        },
        "commentMode": {
          "enum": [
            "auto",
            "manual"
          ],
          "description": "Whether the scene comments are chosen by score or by hand. The per-run drawer overrides it."
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "ratio": {
          "enum": [
            "4:5",
            "1:1",
            "9:16"
          ]
        },
        "highlight": {
          "enum": [
            "none",
            "after-colon",
            "first-clause"
          ]
        },
        "background": {
          "enum": [
            "article",
            "none"
          ]
        },
        "engine": {
          "enum": [
            "classic",
            "studio"
          ]
        },
        "theme": {
          "enum": [
            "sang",
            "toi",
            "pastel",
            "bao"
          ]
        },
        "font": {
          "enum": [
            "BeVietnamPro-Black",
            "BeVietnamPro-Bold",
            "BeVietnamPro-Medium",
            "BeVietnamPro-Regular"
          ]
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 96
        },
        "titleSize": {
          "type": "integer",
          "minimum": 24,
          "maximum": 160
        },
        "highlightColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "width": {
          "type": "integer",
          "minimum": 40,
          "maximum": 100,
          "description": "How much of the frame's width the text block spans, in percent."
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Where the text block sits vertically, in percent. 100 is the bottom."
        },
        "comments": {
          "enum": [
            "none",
            "group"
          ],
          "description": "none: a headline card. group: the headline plus the chosen comments on one card."
        }
      },
      "description": "engine 'classic' = GET /api/image/card (brand overlay, og:image upgrade, focal crop; reads ratio/highlight/background only). engine 'studio' = GET /api/studio/card (theme/font/radius/titleSize/highlightColor/9:16). A field the chosen engine does not read is simply not sent."
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "edge-tts"
          ]
        },
        "voiceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "minimum": 24,
          "maximum": 160
        },
        "pos": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        },
        "wordsPerCue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "case": {
          "enum": [
            "upper",
            "none"
          ]
        },
        "font": {
          "enum": [
            "BeVietnamPro-Black",
            "BeVietnamPro-Bold",
            "BeVietnamPro-Medium",
            "BeVietnamPro-Regular"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "highlightMode": {
          "enum": [
            "word",
            "block",
            "none"
          ]
        },
        "highlightColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "highlightBg": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "outlineWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "shadow": {
          "type": "boolean"
        },
        "band": {
          "type": "boolean"
        },
        "bandOpacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "Flat here, nested in deploy/caption_style.py: kits/load.ts's captionStyle() maps between them. A schema-driven form edits flat keys far better than nested objects, and the renderer's own shape is not something a kit should have to mirror."
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "card-top",
            "continuous",
            "multi"
          ],
          "description": "multi is what the renderer already does (one plate per scene). The other two are composed by the overlay pass, which then places the card itself."
        },
        "intro": {
          "type": "boolean"
        },
        "durationBand": {
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "background": {
          "type": "string"
        }
      }
    },
    "stickers": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "where": {
          "type": "array",
          "items": {
            "enum": [
              "cover",
              "intro",
              "reactions"
            ]
          }
        },
        "fly": {
          "enum": [
            "cheo",
            "nay"
          ],
          "description": "How the intro sticker arrives."
        },
        "pick": {
          "enum": [
            "fixed",
            "ai"
          ],
          "description": "fixed: the sticker named above. ai: one call chooses among your uploads by name."
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "handle": {
          "type": "boolean"
        },
        "watermark": {
          "type": "boolean"
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preset": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "none",
            "soft",
            "groove"
          ]
        },
        "track": {
          "type": "string"
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Chỉnh lớp. Keyed by frame; units are 0..1 of the frame, never pixels, so a kit stays portable across frame sizes. What the engine burns in (the card, the subtitle) is not here — every layer is above it by construction.",
      "properties": {
        "hook": {
          "$ref": "#/definitions/layerList"
        },
        "body": {
          "$ref": "#/definitions/layerList"
        }
      }
    },
    "layerList": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y",
          "w",
          "h",
          "z"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "image",
              "shape",
              "banner"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "w": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "h": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "z": {
            "type": "integer"
          },
          "locked": {
            "type": "boolean"
          },
          "group": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "bg": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "size": {
                "type": "number",
                "minimum": 0.005,
                "maximum": 0.3
              },
              "radius": {
                "type": "integer",
                "minimum": 0,
                "maximum": 96
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "media": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}