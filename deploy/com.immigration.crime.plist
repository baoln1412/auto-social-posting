<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.immigration.crime</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/nguyenbaole/auto-social-posting/deploy/run-crime.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Cases attempted per daily batch. Measured: ~13 min to write one, ~4 min to reject
         one, so 8 finishes well before mid-morning. Each case is its own claude
         invocation, so raising this costs time, not output quality. -->
    <key>CRIME_SERIES_PER_RUN</key>
    <string>8</string>
  </dict>

  <!-- Once a day at 04:00. Was 06:00; moved earlier so a batch that runs long is still
       finished before the working day rather than arriving through it. At the measured
       3-way rate a full eight takes about an hour, so this lands around 05:00. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/nguyenbaole/auto-social-posting/data/crime.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nguyenbaole/auto-social-posting/data/crime.log</string>
</dict>
</plist>
