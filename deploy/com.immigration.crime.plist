<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.immigration.crime</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/nguyenbaole/auto-social-posting/deploy/run-crime.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Series delivered per daily batch, not cases attempted (run-crime.sh applies its own
         MAX_ATTEMPTS ceiling on top). Was 8; the user judged 4 posts/day enough. Each case is
         its own claude invocation, so lowering this saves real cost, not just wall clock -
         both TARGET*2 attempt ceiling and TARGET*2 discovery-fill size scale down with it. -->
    <key>CRIME_SERIES_PER_RUN</key>
    <string>4</string>
  </dict>

  <!-- Once a day at 04:00. Was 06:00; moved earlier so a batch that runs long is still
       finished before the working day rather than arriving through it. At the measured
       3-way rate a full eight takes about an hour, so this lands around 05:00. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/nguyenbaole/auto-social-posting/data/crime.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nguyenbaole/auto-social-posting/data/crime.log</string>
</dict>
</plist>
