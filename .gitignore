# Next.js
.next/
out/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# Build
build/
dist/

# TypeScript
tsconfig.tsbuildinfo
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code — local settings stay out, but the pipeline SOP is source: it defines
# every generated post and the FB-compliance gate. Git will not descend into an
# excluded directory, so each level is excluded by /* and re-included by name.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/immigration-pipeline/
.vercel
.env*.local

# Local project memory (not committed)
.mem/

# user-uploaded card images (runtime)
public/uploads/
data/uploads/

# Runtime lake + generated media (~700MB). The DuckDB lake, rendered reels and
# focal-point cache are all reproducible from the pipeline — never commit them.
data/

# Vendored clone of coreyhaines31/marketingskills — it carries its own .git,
# so committing it would embed a broken gitlink. Re-clone it instead.
vendor/

# Throwaway card-render QA screenshots (16MB of PNGs)
card-review/

# Python bytecode from deploy/
__pycache__/
*.pyc
